# Copy to .env (never commit .env). Real environment variables override this file.

# --- Required ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Fallback chain (free-tier Gemini models). If one fails, the next is used automatically.
# Check ai.google.dev/gemini-api/docs/deprecations for current model names.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# --- Paths ---
OUTPUT_DIR=output
# TEMP_DIR=output/tmp
MUSIC_FILE=~/music/track1.mp3
LOGO_FILE=~/logo.png

# --- Transcription: auto = faster-whisper (if installed) -> Groq (free) -> Gemini (last resort) ---
# Free key: console.groq.com. Set TRANSCRIBE_ENGINE=groq to stop Gemini ever being used for transcription.
GROQ_API_KEY=
GROQ_MODELS=whisper-large-v3-turbo,whisper-large-v3
TRANSCRIBE_ENGINE=auto
WHISPER_MODEL=base
# WHISPER_LANGUAGE=hi          # empty = auto-detect (hi, en, ...)

# --- Clip selection ---
CLIP_COUNT=3
CLIP_DURATIONS=15,30,45,60

# --- Captions: karaoke | bold | minimal | neon | podcast ---
CAPTION_ENABLED=true
CAPTION_STYLE=karaoke
CAPTION_FONT=Noto Sans
CAPTION_FONT_HINDI=Noto Sans Devanagari
# CAPTION_FONTS_DIR=~/fonts    # folder with .ttf files, recommended on Termux
EXPORT_SRT=false

# --- Video ---
FIT_MODE=auto                  # auto | crop | blur
FACE_TRACKING=true
ZOOM=0.06                      # 0 = off
LOGO_SIZE=120
INTRO_HOOK=false
OUTRO_ENABLED=true
OUTRO_LINES=Subscribe to Daily Creates|Like  Comment  Share|Hit the Bell
TRANSITION_SEC=0.3             # 0 = hard cut

# --- Audio ---
MUSIC_VOLUME=0.15
DUCK_MUSIC=true
NORMALIZE_AUDIO=true
REMOVE_SILENCE=false
SILENCE_DB=-35
SILENCE_MIN_SEC=0.7

# --- Publishing ---
AUTO_UPLOAD=true
REVIEW_MODE=false              # true = ask before each upload
PUBLISH_START_DELAY_MIN=20
PUBLISH_INTERVAL_HOURS=3
UPLOAD_RETRIES=5

# --- Web app (optional) ---
# DATA_DIR=data                  # where the web app keeps its database, uploads and YouTube tokens
# CLIPPER_ALLOWED_HOSTS=         # extra Host names when you open the app over a LAN address (comma separated)

# --- Look (optional; these can also be set on the Style screen) ---
# TEMPLATE=blur                  # blur | tweet (white, tweet card) | black
# TWEET_NAME=Your Name
# TWEET_HANDLE=@yourhandle
# TWEET_AVATAR=                  # empty = use LOGO_FILE
# CAPTION_MODE=words             # words (word by word) | single (one line for the whole video)
# MAX_HEIGHT=1080                # download quality ceiling: 360 | 480 | 720 | 1080
